# Put this file into /etc/udev/rules.d and unplug and re-plug your device.
# You don't need to restart Udev, new permissions will be picked up automatically.
#
# Covers all three device classes of the merged plugin:
#   04b4:8613 - unconfigured FX2LP bootstrap mode (gen1 firmware upload)
#   6666:6620 - legacy first-generation capture device
#   1209:6688 - current capture device (gen1 rev 0x0001 / gen2 rev 0x0602)

ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="8613", MODE="0666"
ATTRS{idVendor}=="6666", ATTRS{idProduct}=="6620", MODE="0666"
ATTRS{idVendor}=="1209", ATTRS{idProduct}=="6688", MODE="0666"